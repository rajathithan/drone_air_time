# This is an example .env file for the Drone Air Time application. Copy this file to .env and fill in the required values.

# Google Cloud configuration
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=your-google-cloud-location

# Model configuration
GOOGLE_GENAI_USE_VERTEXAI=1
MODEL=gemini-2.5-flash

# MCP endpoints
FIRESTORE_MCP_URL=https://your-firestore-mcp-url
CALENDAR_MCP_BASE_URL=https://your-calendar-mcp-base-url
